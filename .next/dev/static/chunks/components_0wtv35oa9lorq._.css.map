  border-radius: 0.4rem;
  color: #fff;
  background-size: 220%;
  outline: 2px solid #fff;
  background-image: linear-gradient(
    120deg,
    transparent 0%,
    transparent 50%,
    theme("colors.purple") 50%
  );
  transition: all 0.3s ease-in-out;

  &:hover,
  &:active {
    background-position: 100%;
    color: #fff;
