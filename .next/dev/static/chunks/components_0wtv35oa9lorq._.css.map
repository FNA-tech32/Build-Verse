.secondary__button {
  position: relative;
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  font-family: theme("fontFamily.mono");
  font-size: 0.8rem;
  font-weight: 800;

  padding: 0.65rem 1.75rem;
