.intro {
  animation: fadeAppear 0.6s 0.1s backwards;
}

.heroName{
    line-height: 1.5em;
    animation: fadeAppear 0.8s 0.2s backwards;

    .emphasize {
        &::after {
            content: '';
            position: absolute;
            bottom: 0.7rem;
            left: 0;
            width: 100%;
            height: 0.35rem;
            border-radius: 1rem;
            background-image: linear-gradient(to right, theme("colors.indigo.light"), theme("colors.indigo.dark"));
            box-shadow: 0 0 1rem theme("colors.indigo.dark");
            animation: growHorizontal 1s cubic-bezier(0.9, 0, 0.5, 0.9) 0.6s backwards;
        }
    }
}


@keyframes fadeAppear {
  0% {
    opacity: 0;
  }

  50% {
    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

@keyframes growHorizontal {
    from {
      width: 0;
    }
    to {
      width: 98%; 
    }
  }

